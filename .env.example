# Modelo público: sem chave ou credencial utilizável.
# gerenciar_linux.py instalar gera a chave privada automaticamente.
DJANGO_SECRET_KEY=
SELOS_MODE=local
SELOS_PORT=8004
PUBLIC_BASE_URL=http://127.0.0.1:8004

# Nenhuma câmera é acessada na demonstração.
LPR_ENABLED=false
LPR_CAM_IP=
LPR_CAM_USER=
LPR_CAM_PASS=
LPR_CAMERA_NAME=CAMERA_DEMO
LPR_POLL_SECONDS=2
LPR_FORWARD_MOVEMENT=ENTRADA
LPR_REVERSE_MOVEMENT=SAIDA
LPR_UNKNOWN_MOVEMENT=PASSAGEM
