# OPTIONAL. Review paths and user before installing this unit.
# Never replace the existing system's unit. This is a DIFFERENT instance on port 8004.
[Unit]
Description=Selos Veiculares - nova instalacao Linux
After=network.target

[Service]
Type=simple
User=SEU_USUARIO
WorkingDirectory=/home/SEU_USUARIO/sistema-selos-veiculares-demo
ExecStart=/home/SEU_USUARIO/sistema-selos-veiculares-demo/.venv/bin/python /home/SEU_USUARIO/sistema-selos-veiculares-demo/gerenciar_linux.py iniciar
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
